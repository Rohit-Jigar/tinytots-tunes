# ==========================================
# TinyTots Tunes - Environment Configuration
# ==========================================

# Application Settings
APP_NAME="TinyTots Tunes Video Factory"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Storage Directories
DATA_DIR="./data"
PROJECTS_DIR="./projects"

# ------------------------------------------
# Asset Generation Providers
# ------------------------------------------
# Image Generation Provider: 'pollinations' (free, no key needed), 'openai', 'stability', or 'mock'
IMAGE_PROVIDER="pollinations"

# Voice Generation Provider: 'edge_tts' (free neural voices), 'elevenlabs', 'openai', or 'mock'
VOICE_PROVIDER="edge_tts"
DEFAULT_VOICE_NAME="en-US-AnaNeural"

# Music Generation Provider: 'procedural' (built-in synth, no key needed), 'suno', 'udio', or 'mock'
MUSIC_PROVIDER="procedural"

# ------------------------------------------
# API Keys (Optional based on chosen provider)
# ------------------------------------------
# OpenAI API Key (for DALL-E 3 and OpenAI TTS)
OPENAI_API_KEY=""

# Stability AI API Key (for SDXL image generation)
STABILITY_API_KEY=""

# ElevenLabs API Key (for premium cloned/neural voices)
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""

# Suno AI API Key
SUNO_API_KEY=""

# ------------------------------------------
# Video Rendering Engines
# ------------------------------------------
# FFmpeg binary path (if not in system PATH)
FFMPEG_PATH="ffmpeg"

# Blender binary path (leave empty if not installed; engine will generate blender scripts and use FFmpeg compositor)
BLENDER_PATH=""

# Video Defaults
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30

# ------------------------------------------
# YouTube API Configuration
# ------------------------------------------
# Set to True to use Mock YouTube Uploader for development/testing without live credentials
YOUTUBE_MOCK_MODE=True

# Path to client_secrets.json downloaded from Google Cloud Console
YOUTUBE_CLIENT_SECRETS_FILE="client_secrets.json"
YOUTUBE_CREDENTIALS_STORAGE="youtube_token.json"

# Default YouTube Video Settings
YOUTUBE_DEFAULT_PRIVACY="private"  # 'private', 'unlisted', 'public'
YOUTUBE_CATEGORY_ID="1"           # 1 = Film & Animation, 27 = Education
YOUTUBE_MADE_FOR_KIDS=True        # Required True for COPPA compliance

# ------------------------------------------
# Automation & Queue Worker
# ------------------------------------------
MAX_CONCURRENT_JOBS=2
QUEUE_POLL_INTERVAL=5
AUTO_RETRY_FAILED=True
MAX_RETRIES=3
AUTO_PUBLISH_APPROVED=False       # Never publish without explicit approval

